void film_expose(uint p) {
        float r   = input_rgb[p*3u] * film_controls(0);
        float g   = input_rgb[p*3u+1u] * film_controls(0);
        float bch = input_rgb[p*3u+2u] * film_controls(0);

        float X = 0.78940291537782703 * r + 0.12282122346225685 * g + 0.044468206688454449 * bch;
        float Y = 0.28698841093710081 * r + 0.71347859576974382 * g + -0.00046667083367552562 * bch;
        float Z = 0.0014710100935912593 * r + 0.0038855140649431182 * g + 0.91578379979792301 * bch;
        float bsum = X + Y + Z;
        float denom = max(bsum, 1e-10);
        float cx = X / denom;
        float cy = Y / denom;
        float qy = clamp(cy / max(1.0 - cx, 1e-10), 0.0, 1.0);
        float qx = clamp((1.0 - cx) * (1.0 - cx), 0.0, 1.0);
        float bmul = bsum;

        int L = int(film_controls(2));
        float scale = float(L - 1);
        int xb; float xf = cubic_bf(qx * scale, L, xb);
        int yb; float yf = cubic_bf(qy * scale, L, yb);
        float wx[4] = float[4](mitchell(xf + 1.0), mitchell(xf),
                               mitchell(xf - 1.0), mitchell(xf - 2.0));
        float wy[4] = float[4](mitchell(yf + 1.0), mitchell(yf),
                               mitchell(yf - 1.0), mitchell(yf - 2.0));
        float acc0 = 0.0, acc1 = 0.0, acc2 = 0.0, wsum = 0.0;
        for (int i = 0; i < 4; ++i) {
            int xi = safe_index(xb - 1 + i, L);
            for (int j = 0; j < 4; ++j) {
                int yj = safe_index(yb - 1 + j, L);
                float w = wx[i] * wy[j];
                wsum += w;
                int cell = (xi * L + yj) * 3;
                acc0 += w * film_lut(cell + 0);
                acc1 += w * film_lut(cell + 1);
                acc2 += w * film_lut(cell + 2);
            }
        }
        if (wsum != 0.0) { acc0 /= wsum; acc1 /= wsum; acc2 /= wsum; }


        vec3 v=vec3(acc0,acc1,acc2)*bmul*film_controls(1);
        if(film_controls(3)==0.0) v=log(max(v,vec3(0.0))+vec3(1e-10))/log(10.0);
        for(int k=0;k<3;++k) output_rgb[p*3u+k]=v[k];

}
