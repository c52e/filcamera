float paper_develop(float x,int c) {
    int n=int(film_controls(0));
    if(x<=film_lut(c)) return film_lut(3*n+c);
    if(x>=film_lut(3*(n-1)+c)) return film_lut(3*n+3*(n-1)+c);
    int lo=0,hi=n;
    while(lo<hi) {int mid=lo+(hi-lo)/2;if(x<film_lut(3*mid+c)) hi=mid;else lo=mid+1;}
    int k=clamp(lo-1,0,n-2);
    FC_PRECISE float dx=film_lut(3*(k+1)+c)-film_lut(3*k+c);
    FC_PRECISE float t=dx!=0.0?(x-film_lut(3*k+c))/dx:0.0;
    FC_PRECISE float y=film_lut(3*n+3*k+c)+t*(film_lut(3*n+3*(k+1)+c)-film_lut(3*n+3*k+c));
    return y;
}
float develop_interp(float x,int c,int axis,int curve,int n) {
    if(x<=film_lut(axis+c)) return film_lut(curve+c);
    if(x>=film_lut(axis+3*(n-1)+c)) return film_lut(curve+3*(n-1)+c);
    int lo=0,hi=n;
    while(lo<hi) {int mid=lo+(hi-lo)/2;if(x<film_lut(axis+3*mid+c)) hi=mid;else lo=mid+1;}
    int k=clamp(lo-1,0,n-2);
    FC_PRECISE float dx=film_lut(axis+3*(k+1)+c)-film_lut(axis+3*k+c);
    FC_PRECISE float t=dx!=0.0?(x-film_lut(axis+3*k+c))/dx:0.0;
    FC_PRECISE float y=film_lut(curve+3*k+c)+t*(film_lut(curve+3*(k+1)+c)-film_lut(curve+3*k+c));
    return y;
}
void develop_dir(uint p) {
    int n=int(film_controls(0));
    vec3 raw=vec3(input_rgb[3*p],input_rgb[3*p+1],input_rgb[3*p+2]);
    FC_PRECISE vec3 density;
    for(int c=0;c<3;++c) density[c]=develop_interp(raw[c],c,12,12+3*n,n);
    if(film_controls(1)!=0.0) {
        FC_PRECISE vec3 silver=film_controls(2)!=0.0?vec3(film_lut(9),film_lut(10),film_lut(11))-density:density;
        for(int c=0;c<3;++c) silver[c]+=film_controls(3)*silver[c]*silver[c];
        for(int c=0;c<3;++c) {
            FC_PRECISE float correction=0.0;
            for(int k=0;k<3;++k) correction+=silver[k]*film_lut(3*k+c);
            FC_PRECISE float query=raw[c]-correction;
            density[c]=params.operation==5u ? correction : develop_interp(query,c,12+6*n,12+9*n,n);
        }
    }
    for(int c=0;c<3;++c) output_rgb[3*p+c]=density[c];
}
