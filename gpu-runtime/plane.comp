#version 450
layout(local_size_x=64) in;
layout(binding=0,std430) readonly buffer Source {float src[];};
layout(binding=1,std430) buffer Destination {float dst[];};
layout(push_constant) uniform Push {uint count,srcStride,srcOffset,dstStride,dstOffset,op;float amount;} p;
void main() {
    uint i=gl_GlobalInvocationID.x+gl_GlobalInvocationID.y*gl_NumWorkGroups.x*64u;
    if(i>=p.count) return;
    uint si=i*p.srcStride+p.srcOffset,di=i*p.dstStride+p.dstOffset;
    float value=src[si];
    if(p.op==1u) value=isnan(value)||isinf(value)?0.0:value;
    if(p.op==2u) {precise float a=(1.0-p.amount)*value;precise float b=p.amount*dst[di];value=a+b;}
    dst[di]=value;
}
